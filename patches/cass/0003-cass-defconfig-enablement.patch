From 41559a9056d02c7084fbc08304f47115115db967 Mon Sep 17 00:00:00 2001
From: dtingley11 <l0tsofcub3s@gmail.com>
Date: Thu, 29 Oct 2026 20:32:17 -0700
Subject: [PATCH] arm64: defconfig: Enable CASS

Enable the Capacity Aware Superset Scheduler (CONFIG_SCHED_CASS) in the
arm64 GKI defconfig.

Requires CONFIG_UCLAMP_TASK, which is always enabled in GKI 5.15 arm64
defconfigs (uclamp is part of the GKI specification).
---
 arch/arm64/configs/gki_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 29e7bba5a..34928b2c7 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -31,6 +31,7 @@ CONFIG_CGROUP_CPUACCT=y
 CONFIG_CGROUP_BPF=y
 CONFIG_NAMESPACES=y
 # CONFIG_PID_NS is not set
+CONFIG_SCHED_CASS=y
 CONFIG_RT_SOFTINT_OPTIMIZATION=y
 CONFIG_RELAY=y
 # CONFIG_RD_BZIP2 is not set
-- 
2.56.0

